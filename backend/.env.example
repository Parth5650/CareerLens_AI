# Backend API Environment Variables
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token_here
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.mongodb.net/careerlens_ai?retryWrites=true&w=majority
FRONTEND_URL=https://your-frontend-deployment.vercel.app
JWT_SECRET=your_jwt_secret_key_here

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM=noreply@careerlensai.com
